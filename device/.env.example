DAILY_MIRROR_SERVER_URL=http://192.168.1.10:3000
DAILY_MIRROR_UPLOAD_TOKEN=replace-me
DAILY_MIRROR_QUEUE_DIR=./data/pending
DAILY_MIRROR_ADMIN_BIND=0.0.0.0:8080

# Raspberry Pi camera command and optional extra arguments.
# DAILY_MIRROR_CAMERA_COMMAND=rpicam-still
# IMX519 continuous portrait autofocus example:
# DAILY_MIRROR_CAMERA_ARGS=--nopreview --timeout 3000 --autofocus-mode continuous --autofocus-range normal --autofocus-speed fast --autofocus-window 0.2,0.15,0.6,0.7 --metadata-format json --metadata - --width 4656 --height 3496 --encoding jpg --quality 95
# Fixed-focus four-foot starting point; calibrate the lens position on the actual module:
# DAILY_MIRROR_CAMERA_ARGS=--nopreview --timeout 3000 --autofocus-mode manual --lens-position 0.82 --metadata-format json --metadata - --width 4656 --height 3496 --encoding jpg --quality 95

# BCM GPIO numbering. Defaults retain the original button and LED pin where possible.
DAILY_MIRROR_BUTTON_PIN=2
DAILY_MIRROR_GREEN_LED_PIN=17
DAILY_MIRROR_YELLOW_LED_PIN=27
DAILY_MIRROR_RED_LED_PIN=22
