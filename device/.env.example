DAILY_MIRROR_SERVER_URL=http://192.168.1.10:3000
DAILY_MIRROR_UPLOAD_TOKEN=replace-me
DAILY_MIRROR_QUEUE_DIR=./data/pending
DAILY_MIRROR_ADMIN_BIND=0.0.0.0:8080

# Raspberry Pi camera command and optional extra arguments.
# DAILY_MIRROR_CAMERA_COMMAND=rpicam-still
# IMX519 portrait config validated in docs/focus-experiments.md: the centered
# autofocus window is essential (without it AF averages the background and
# back-focuses off close-up subjects), sport exposure limits motion blur, and
# metadata logging records where focus/exposure landed for every capture.
# DAILY_MIRROR_CAMERA_ARGS=--nopreview --timeout 3000 --autofocus-mode auto --autofocus-on-capture --autofocus-window 0.3,0.3,0.4,0.4 --width 4656 --height 3496 --encoding jpg --quality 95 --sharpness 1.5 --exposure sport --metadata - --metadata-format json

# BCM GPIO numbering. Defaults retain the original button and LED pin where possible.
DAILY_MIRROR_BUTTON_PIN=2
DAILY_MIRROR_GREEN_LED_PIN=17
DAILY_MIRROR_YELLOW_LED_PIN=27
DAILY_MIRROR_RED_LED_PIN=22

# Original three LEDs: discrete (default).
# Four-leg RGB, common positive to 3.3 V: rgb-common-anode.
# In RGB mode the YELLOW_LED_PIN is the physical BLUE channel; yellow is red+green.
DAILY_MIRROR_LED_MODE=discrete

# Development captures stay local even when server credentials are present.
# Existing installations without this setting retain upload behavior.
DAILY_MIRROR_CAPTURE_MODE=local
DAILY_MIRROR_LOCAL_DIR=./data/local

# Shared by normal capture, live preview and camera-lab stills:
# imx519 (Arducam AF), ov5647 (Pi Camera v1), imx219 (Pi Camera v2).
DAILY_MIRROR_CAMERA_PROFILE=imx519
