PORT=3000
DAILY_MIRROR_STORAGE_BACKEND=local
DAILY_MIRROR_STORAGE_DIR=./data/photos
# Local development defaults to server/data/daily-mirror.db when omitted.
# DAILY_MIRROR_DATABASE_URL=libsql://daily-mirror-<org>.turso.io
# DAILY_MIRROR_DATABASE_AUTH_TOKEN=replace-me
# Set this in production. When omitted, uploads are unauthenticated for local development.
DAILY_MIRROR_UPLOAD_TOKEN=replace-me
# Canonical production origin used to bind passkeys to this site. Preview
# deployments derive their temporary HTTPS origin from VERCEL_URL.
# DAILY_MIRROR_AUTH_ORIGIN=https://daily-mirror.example.com
# Override only when the passkey relying-party ID differs from the origin host.
# DAILY_MIRROR_AUTH_RP_ID=daily-mirror.example.com
# Required by the production-only daily Vercel reconciliation job.
# CRON_SECRET=replace-with-at-least-16-random-characters

# Optional household realtime proof of concept. Leave DAILY_MIRROR_REALTIME_URL
# unset to retain the normal 60-second gallery polling without WebSockets.
# DAILY_MIRROR_REALTIME_URL=http://127.0.0.1:8787
# DAILY_MIRROR_HOUSEHOLD_ID=home
# DAILY_MIRROR_REALTIME_TICKET_SECRET=replace-with-at-least-32-random-characters
# DAILY_MIRROR_REALTIME_PUBLISH_TOKEN=replace-with-a-different-32-character-secret

# Production Cloudflare R2 storage. The endpoint is account-specific and does not include
# the bucket name, for example: https://<account-id>.r2.cloudflarestorage.com
# DAILY_MIRROR_STORAGE_BACKEND=r2
# DAILY_MIRROR_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DAILY_MIRROR_R2_BUCKET=daily-mirror
# DAILY_MIRROR_R2_ACCESS_KEY_ID=replace-me
# DAILY_MIRROR_R2_SECRET_ACCESS_KEY=replace-me
# DAILY_MIRROR_R2_PREFIX=photos
# DAILY_MIRROR_R2_PRESIGN_SECONDS=300
# DAILY_MIRROR_R2_URL_STYLE=virtual-host
